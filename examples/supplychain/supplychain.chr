constraints supplier/3, product/4, order/3, shipment/4, warehouse/2;
functions is_backordered/1, is_oversupplied/1, is_fragile/1, demand/1, lead_time/2;
actions log/1;
import host builtins;

supplier(X, L, R) <=> eq(R, "inactive") | !log("Inactive supplier");
product(X, N, C, S) <=> eq(S, "discontinued") | !log("Discontinued product");
order(X, C, S) <=> eq(S, "cancelled") | !log("Cancelled order");
shipment(X, O, D, S) <=> eq(S, "lost") | !log("Lost shipment");
warehouse(X, C) <=> eq(C, "closed") | !log("Closed warehouse");
supplier(X, L, R) <=> is_oversupplied(L) | !log("Oversupplied");
product(X, N, C, S) <=> is_fragile(C) | !log("Fragile product");
supplier(X, L, R), order(X, C, S) ==> demand(C) | !log("Demand noted");
product(X, N, C, S), shipment(X, O, D, S) ==> lead_time(O, D) | !log("Lead time");
warehouse(X, C), shipment(X, O, D, S) ==> is_backordered(S) | !log("Backordered");
order(X, C, S) ==> eq(S, "awaiting") | !log("Awaiting order");
shipment(X, O, D, S) ==> eq(S, "shipped") | !log("Shipped");
warehouse(X, C) ==> eq(C, "active") | !log("Active warehouse");
supplier(X, L, R) ==> eq(R, "active") | !log("Active supplier");
order(X, C, S) \ product(X, N, C, S) <=> demand(C) | order(X, C, S), !log("Order demand");
shipment(X, O, D, S) \ warehouse(X, C) <=> eq(C, "active") | shipment(X, O, D, S), !log("Warehouse shipment");
product(X, N, C, S) \ supplier(X, L, R) <=> is_fragile(C) | product(X, N, C, S), !log("Fragile from supplier");
order(X, C, S) \ order(X, C, S) <=> eq(S, "processing") | order(X, C, "processing"), !log("Order processing");
shipment(X, O, D, S) \ shipment(X, O, D, S) <=> eq(S, "in_transit") | shipment(X, O, D, "in_transit"), !log("Shipment in transit");
warehouse(X, C) \ warehouse(X, C) <=> eq(C, "active") | warehouse(X, C), !log("Warehouse validated");