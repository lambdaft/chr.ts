constraints patient/4, appointment/4, diagnosis/3, treatment/3, prescription/3;
functions urgent/1, follow_up/2, duration/2, is_valid/1, refill/2;
actions log/1;
import host builtins;

patient(X, N, A, C) <=> lt(A, 0) | !log("Invalid age");
appointment(X, D, T, R) <=> eq(R, "cancelled") | !log("Cancelled appointment");
diagnosis(X, C, S) <=> eq(S, "unknown") | !log("Unknown diagnosis");
treatment(X, N, P) <=> eq(P, "finished") | !log("Treatment finished");
prescription(X, M, D) <=> lt(D, 0) | !log("Invalid dosage");
patient(X, N, A, C) <=> urgent(C) | !log("Urgent patient");
diagnosis(X, C, S) <=> follow_up(C, true) | !log("Follow up needed");
patient(X, N, A, C), appointment(X, D, T, R) ==> lt(A, 18) | diagnosis(X, "pediatric", "monitor"), !log("Pediatric case");
diagnosis(X, C, S), treatment(X, N, P) ==> eq(S, "critical") | treatment(X, N, "immediate"), !log("Emergency treatment");
prescription(X, M, D), treatment(X, N, P) ==> refill(M, true) | prescription(X, M, add(D, 30)), !log("Refill prescribed");
appointment(X, D, T, R) ==> eq(R, "confirmed") | !log("Appointment confirmed");
treatment(X, N, P) ==> eq(P, "completed") | !log("Treatment completed");
prescription(X, M, D) ==> is_valid(D) | !log("Valid prescription");
patient(X, N, A, C) ==> duration(A, C) | !log("Duration estimated");
patient(X, N, A, C) \ diagnosis(X, C, S) <=> eq(S, "critical") | treatment(X, "emergency", "immediate"), !log("Emergency created");
appointment(X, D, T, R) \ treatment(X, N, P) <=> eq(R, "follow-up") | appointment(X, D, T, R), !log("Follow-up scheduled");
diagnosis(X, C, S) \ prescription(X, M, D) <=> refill(M, true) | diagnosis(X, C, S), !log("Refill authorized");
treatment(X, N, P) \ treatment(X, N, P) <=> eq(P, "ongoing") | treatment(X, N, "ongoing"), !log("Treatment ongoing");
prescription(X, M, D) \ prescription(X, M, D) <=> gt(D, 0) | prescription(X, M, D), !log("Prescription active");
patient(X, N, A, C) \ patient(X, N, A, C) <=> eq(C, "stable") | patient(X, N, A, "stable"), !log("Patient stable");