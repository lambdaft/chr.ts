constraints station/5, alert/3, advisory/3, forecast/4, reading/3;
functions temp_f/1, is_severe/1, humidity/1, wind_speed/1, uv_index/1;
actions log/1;
import host builtins;

station(X, N, La, Lo, E) <=> lt(E, 0) | !log("Invalid elevation");
alert(X, T, L) <=> eq(L, "info") | !log("Info alert");
advisory(X, T, M) <=> eq(M, "none") | !log("No advisory");
forecast(X, D, H, L) <=> gt(L, H) | !log("Low higher than high");
reading(X, T, V) <=> lt(V, -100) | !log("Invalid reading");
station(X, N, La, Lo, E) <=> lt(E, 0) | !log("Below sea level");
alert(X, T, L) <=> is_severe(L) | !log("Severe alert");
forecast(X, D, H, L), alert(X, T, L) ==> is_severe(L) | alert(X, T, "severe"), !log("Severe forecast alert");
reading(X, T, V), station(X, N, La, Lo, E) ==> temp_f(V) | !log("Temp reading");
forecast(X, D, H, L), advisory(X, T, M) ==> humidity(H) | advisory(X, "humidity", "high"), !log("Humidity advisory");
alert(X, T, L) ==> eq(L, "warning") | !log("Warning alert");
advisory(X, T, M) ==> eq(T, "heat") | !log("Heat advisory");
forecast(X, D, H, L) ==> wind_speed(H) | !log("Wind forecast");
reading(X, T, V) ==> uv_index(V) | !log("UV reading");
station(X, N, La, Lo, E) \ reading(X, T, V) <=> temp_f(V) | station(X, N, La, Lo, E), !log("Station reading");
forecast(X, D, H, L) \ advisory(X, T, M) <=> is_severe(L) | forecast(X, D, H, L), !log("Forecast advisory");
alert(X, T, L) \ reading(X, T, V) <=> wind_speed(V) | alert(X, T, "wind"), !log("Wind alert");
advisory(X, T, M) \ advisory(X, T, M) <=> eq(M, "active") | advisory(X, T, "active"), !log("Advisory active");
forecast(X, D, H, L) \ forecast(X, D, H, L) <=> gt(H, L) | forecast(X, D, H, L), !log("Forecast validated");
reading(X, T, V) \ reading(X, T, V) <=> gt(V, -100) | reading(X, T, V), !log("Reading validated");