constraints route/3, delivery/4, vehicle/3, package/3, driver/2;
functions is_express/1, eta/2, is_valid/1, capacity/1, distance/2;
actions log/1;
import host builtins;

route(X, O, D) <=> eq(O, D) | !log("Same origin destination");
delivery(X, P, D, S) <=> eq(S, "cancelled") | !log("Cancelled delivery");
vehicle(X, T, C) <=> lt(C, 0) | !log("Negative capacity");
package(X, W, F) <=> lt(W, 0) | !log("Negative weight");
driver(X, L) <=> eq(L, "unavailable") | !log("Unavailable driver");
route(X, O, D) <=> is_express(O) | !log("Express route");
delivery(X, P, D, S) <=> is_valid(S) | !log("Valid delivery");
vehicle(X, T, C), package(X, W, F) ==> capacity(C) | !log("Capacity checked");
route(X, O, D), vehicle(X, T, C) ==> distance(O, D) | !log("Distance computed");
delivery(X, P, D, S), driver(X, L) ==> is_express(S) | !log("Express delivery");
driver(X, L) ==> eq(L, "available") | !log("Available driver");
package(X, W, F) ==> lt(W, 50) | !log("Light package");
vehicle(X, T, C) ==> gt(C, 1000) | !log("Heavy duty vehicle");
route(X, O, D) ==> eta(O, D) | !log("ETA computed");
delivery(X, P, D, S) \ vehicle(X, T, C) <=> eq(S, "dispatched") | delivery(X, P, D, S), !log("Delivery dispatched");
package(X, W, F) \ driver(X, L) <=> eq(L, "available") | package(X, W, F), !log("Package assigned");
route(X, O, D) \ route(X, O, D) <=> distance(O, D) | route(X, O, D), !log("Route validated");
delivery(X, P, D, S) \ delivery(X, P, D, S) <=> eq(S, "in_transit") | delivery(X, P, D, "in_transit"), !log("Delivery in transit");
vehicle(X, T, C) \ vehicle(X, T, C) <=> gt(C, 0) | vehicle(X, T, C), !log("Vehicle validated");
driver(X, L) \ driver(X, L) <=> eq(L, "active") | driver(X, L), !log("Driver active");