constraints warehouse/3, shipment/4, stock/3, order/3, supplier/2;
functions is_low/1, quantity/2, is_perishable/1, value/2, is_expedited/1;
actions log/1;
import host builtins;

warehouse(X, L, C) <=> eq(C, "closed") | !log("Closed warehouse");
shipment(X, O, D, S) <=> eq(S, "cancelled") | !log("Cancelled shipment");
stock(X, I, Q) <=> lt(Q, 0) | !log("Negative stock");
order(X, C, S) <=> eq(S, "pending") | !log("Pending order");
supplier(X, R) <=> eq(R, "inactive") | !log("Inactive supplier");
warehouse(X, L, C) <=> is_low(L) | !log("Low stock warehouse");
stock(X, I, Q) <=> is_perishable(I) | !log("Perishable stock");
warehouse(X, L, C), stock(X, I, Q) ==> is_low(L) | order(X, I, "reorder"), !log("Reorder triggered");
shipment(X, O, D, S), supplier(X, R) ==> eq(R, "preferred") | shipment(X, O, D, "priority"), !log("Priority shipment");
stock(X, I, Q), order(X, C, S) ==> quantity(I, Q) | !log("Stock quantity noted");
order(X, C, S) ==> eq(S, "backorder") | !log("Backordered");
supplier(X, R) ==> eq(R, "active") | !log("Active supplier");
warehouse(X, L, C) ==> value(L, C) | !log("Warehouse valued");
shipment(X, O, D, S) ==> is_expedited(S) | !log("Expedited shipment");
warehouse(X, L, C) \ stock(X, I, Q) <=> gt(Q, 100) | warehouse(X, L, C), !log("Stock added");
shipment(X, O, D, S) \ order(X, C, O) <=> eq(S, "shipped") | shipment(X, O, D, "delivered"), !log("Order shipped");
stock(X, I, Q) \ supplier(X, R) <=> eq(R, "active") | stock(X, I, Q), !log("Supplier verified");
order(X, C, S) \ order(X, C, S) <=> eq(S, "fulfilled") | order(X, C, "fulfilled"), !log("Order fulfilled");
warehouse(X, L, C) \ warehouse(X, L, C) <=> gt(L, 0) | warehouse(X, L, C), !log("Warehouse validated");
shipment(X, O, D, S) \ shipment(X, O, D, S) <=> eq(S, "in_transit") | shipment(X, O, D, "in_transit"), !log("Shipment in transit");