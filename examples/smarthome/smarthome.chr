constraints device/3, light/2, thermostat/2, scene/2, sensor_reading/3;
functions is_on/1, target_temp/1, is_night/1, is_occupied/1, brightness/1;
actions log/1;
import host builtins;

device(X, T, S) <=> eq(S, "offline") | !log("Device offline");
light(X, B) <=> lt(B, 0) | !log("Invalid brightness");
thermostat(X, T) <=> lt(T, 10) | !log("Too cold");
scene(X, A) <=> eq(A, "inactive") | !log("Inactive scene");
sensor_reading(X, T, V) <=> lt(V, 0) | !log("Invalid reading");
device(X, T, S) <=> is_on(S) | !log("Device on");
thermostat(X, T) <=> target_temp(T) | !log("Target temp set");
light(X, B), scene(X, A) ==> is_night(A) | light(X, 20), !log("Night light dimmed");
thermostat(X, T), sensor_reading(X, T, V) ==> is_occupied(V) | thermostat(X, 70), !log("Occupied temp");
scene(X, A), device(X, T, S) ==> eq(A, "away") | device(X, T, "off"), !log("Away scene activated");
sensor_reading(X, T, V) ==> brightness(V) | !log("Brightness reading");
device(X, T, S) ==> eq(S, "on") | !log("Device state on");
light(X, B) ==> gt(B, 80) | !log("Bright light");
thermostat(X, T) ==> gt(T, 85) | !log("Hot temp");
device(X, T, S) \ light(X, B) <=> is_on(S) | device(X, T, S), !log("Light controlled");
thermostat(X, T) \ sensor_reading(X, T, V) <=> target_temp(T) | thermostat(X, T), !log("Temp reading");
scene(X, A) \ device(X, T, S) <=> eq(A, "movie") | scene(X, A), !log("Movie scene");
sensor_reading(X, T, V) \ sensor_reading(X, T, V) <=> gt(V, 0) | sensor_reading(X, T, V), !log("Sensor validated");
device(X, T, S) \ device(X, T, S) <=> is_on(S) | device(X, T, S), !log("Device validated");
light(X, B) \ light(X, B) <=> gt(B, 0) | light(X, B), !log("Light validated");