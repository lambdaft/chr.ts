constraints table/2, reservation/3, order/3, menu_item/3, bill/2;
functions is_available/1, total/2, is_vegan/1, is_busy/1, tip/2;
actions log/1;
import host builtins;

table(X, S) <=> eq(S, "occupied") | !log("Table occupied");
reservation(X, T, N) <=> lt(N, 1) | !log("Invalid party size");
order(X, I, S) <=> eq(S, "pending") | !log("Pending order");
menu_item(X, N, P) <=> lt(P, 0) | !log("Negative price");
bill(X, A) <=> lt(A, 0) | !log("Negative bill");
table(X, S) <=> is_available(S) | !log("Table available");
order(X, I, S) <=> is_vegan(I) | !log("Vegan order");
reservation(X, T, N), table(X, S) ==> eq(S, "free") | reservation(X, T, N), !log("Reservation confirmed");
order(X, I, S), menu_item(X, N, P) ==> total(I, P) | bill(X, P), !log("Bill item added");
bill(X, A), order(X, I, S) ==> gt(A, 0) | bill(X, add(A, 10)), !log("Tip added");
menu_item(X, N, P) ==> gt(P, 50) | !log("Premium item");
table(X, S) ==> is_busy(S) | !log("Busy table");
reservation(X, T, N) ==> eq(N, "walkin") | !log("Walk-in reservation");
bill(X, A) ==> eq(A, "paid") | !log("Bill paid");
reservation(X, T, N) \ table(X, S) <=> eq(S, "free") | reservation(X, T, N), !log("Reservation seated");
order(X, I, S) \ menu_item(X, N, P) <=> is_vegan(I) | order(X, I, "vegan"), !log("Vegan order confirmed");
bill(X, A) \ order(X, I, S) <=> eq(S, "completed") | bill(X, A), !log("Order billed");
table(X, S) \ table(X, S) <=> is_available(S) | table(X, S), !log("Table status checked");
menu_item(X, N, P) \ menu_item(X, N, P) <=> gt(P, 0) | menu_item(X, N, P), !log("Menu item set");
reservation(X, T, N) \ reservation(X, T, N) <=> gt(N, 0) | reservation(X, T, N), !log("Reservation confirmed");