constraints product/4, cart/3, order/3, user/3, discount/2, review/3;
functions total/2, apply_disc/2, is_valid/1, in_stock/1, rating/2;
actions log/1;
import host builtins;

product(X, N, P, S) <=> lt(S, 1) | !log("Out of stock");
cart(X, U, I) <=> eq(I, []) | !log("Empty cart");
order(X, U, S) <=> eq(S, "pending") | !log("Pending order");
user(X, E, T) <=> eq(T, "new") | !log("New user");
discount(X, P) <=> gt(P, 50) | !log("Huge discount");
review(X, P, R) <=> lt(R, 1) | !log("Bad review");
product(X, N, P, S) <=> gt(P, 1000) | !log("Expensive item");
cart(X, U, I), discount(X, P) ==> in_stock(I) | cart(X, U, apply_disc(I, P)), !log("Discount applied");
order(X, U, S), user(X, E, T) ==> eq(T, "premium") | order(X, U, "fast_track"), !log("Fast track order");
product(X, N, P, S), cart(X, U, I) ==> lt(S, 5) | !log("Low stock alert");
cart(X, U, I) ==> eq(U, U) | !log("Large order");
order(X, U, S) ==> eq(S, "shipped") | !log("Order shipped");
user(X, E, T) ==> eq(T, "vip") | !log("VIP user");
review(X, P, R) ==> gt(R, 4) | !log("Excellent review");
product(X, N, P, S) \ cart(X, U, I) <=> in_stock(I) | cart(X, U, I), !log("Stock verified");
cart(X, U, I) \ discount(X, P) <=> eq(P, "active") | cart(X, U, I), !log("Discount active");
order(X, U, S) \ review(X, O, R) <=> eq(R, "positive") | order(X, U, S), !log("Order reviewed");
user(X, E, T) \ discount(X, P) <=> eq(T, "new") | discount(X, 10), !log("Welcome discount");
product(X, N, P, S) \ product(X, N, P, S) <=> gt(S, 0) | product(X, N, P, S), !log("Product validated");
cart(X, U, I) \ cart(X, U, I) <=> in_stock(I) | cart(X, U, I), !log("Cart validated");