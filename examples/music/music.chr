constraints song/3, playlist/3, artist/2, album/3, listener/2;
functions is_hit/1, duration/2, genre/1, bpm/1, likes/1;
actions log/1;
import host builtins;

song(X, T, D) <=> lt(D, 30) | !log("Short song");
playlist(X, N, S) <=> eq(S, "private") | !log("Private playlist");
artist(X, G) <=> eq(G, "unknown") | !log("Unknown genre");
album(X, T, Y) <=> lt(Y, 1900) | !log("Old album");
listener(X, S) <=> eq(S, "inactive") | !log("Inactive listener");
song(X, T, D) <=> is_hit(T) | !log("Hit song");
playlist(X, N, S) <=> gt(S, 0) | !log("Songs in playlist");
song(X, T, D), playlist(X, N, S) ==> duration(T, D) | !log("Playlist duration");
artist(X, G), song(X, T, D) ==> genre(G) | !log("Genre noted");
album(X, T, Y), artist(X, G) ==> bpm(T) | !log("BPM noted");
listener(X, S), playlist(X, N, S) ==> likes(S) | !log("Liked playlist");
playlist(X, N, S) ==> eq(S, "public") | !log("Public playlist");
song(X, T, D) ==> bpm(T) | !log("Song BPM");
album(X, T, Y) ==> gt(Y, 2000) | !log("Modern album");
playlist(X, N, S) \ song(X, T, D) <=> is_hit(T) | playlist(X, N, add(S, 1)), !log("Hit added");
artist(X, G) \ album(X, T, Y) <=> genre(G) | artist(X, G), !log("Genre verified");
listener(X, S) \ playlist(X, N, S) <=> eq(S, "public") | listener(X, S), !log("Listener joined");
song(X, T, D) \ song(X, T, D) <=> gt(D, 0) | song(X, T, D), !log("Song validated");
playlist(X, N, S) \ playlist(X, N, S) <=> gt(S, 0) | playlist(X, N, S), !log("Playlist active");
album(X, T, Y) \ album(X, T, Y) <=> gt(Y, 0) | album(X, T, Y), !log("Album year set");