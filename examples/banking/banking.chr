constraints transaction/4, hold/4, statement/4, account/3, deposit/2, withdrawal/2, fee/3, interest/3, auditTrail/4, balanceCheck/3;
functions during/3, before/2, meets/2, overlaps/3, starts/2, ends/2, contains/2, abuts/2, after/2;
actions log/1, flag/1;

import host builtins;

rule_name @ transaction(TxId, Account, Time, Type) <=> during(Time, 9, 17) | !log("Transaction during business hours"), valid(TxId);
rule_name @ transaction(TxId, Account, Time, Type) <=> !during(Time, 9, 17) | !log("Transaction outside hours"), flagged(TxId, "after_hours");

rule_name @ hold(HoldId, Account, StartTime, EndTime), transaction(TxId, Account, TxTime, Type) <=> contains(StartTime, TxTime) | !log("Transaction during hold"), held(TxId, HoldId);
rule_name @ hold(HoldId, Account, StartTime, EndTime), transaction(TxId, Account, TxTime, Type) <=> !contains(StartTime, TxTime) | !log("Transaction outside hold"), processed(TxId);

rule_name @ statement(Account, StmtStart, StmtEnd, Balance), transaction(TxId, Account, TxTime, Type) <=> during(TxTime, StmtStart, StmtEnd) | !log("Transaction in statement period"), statemented(TxId, Account);
rule_name @ statement(Account, StmtStart, StmtEnd, Balance), transaction(TxId, Account, TxTime, Type) <=> overlaps(TxTime, StmtStart, StmtEnd) | !log("Transaction overlaps statement"), adjusted(Account, StmtEnd);

rule_name @ deposit(Account, Amount), account(Account, Type, MinBalance) <=> gt(Amount, 0) | !log("Deposit accepted"), deposited(Account, Amount);
rule_name @ withdrawal(Account, Amount), account(Account, Type, Balance) <=> lte(Amount, Balance) | !log("Withdrawal accepted"), withdrawn(Account, Amount);
rule_name @ withdrawal(Account, Amount), account(Account, Type, Balance) <=> gt(Amount, Balance) | !log("Insufficient funds"), flagged(Account, "overdraft");

rule_name @ fee(Account, FeeTime, Amount), account(Account, Type, Balance) <=> meets(FeeTime, Balance) | !log("Fee applied at balance check"), fee_applied(Account, Amount);
rule_name @ interest(Account, IntTime, Rate), statement(Account, StmtStart, StmtEnd, Balance) <=> starts(IntTime, StmtStart) | !log("Interest at statement start"), interest_applied(Account, Rate);

rule_name @ transaction(TxId, Account, Time, Type), account(Account, Type, Balance) <=> ends(Time, Balance) | !log("Transaction ends at balance"), balanced(Account);
rule_name @ transaction(TxId, Account, Time, Type), transaction(TxId2, Account, Time2, Type2) <=> after(Time, Time2) | !log("Later transaction"), sequenced(TxId, TxId2);
rule_name @ hold(HoldId, Account, StartTime, EndTime), statement(Account, StmtStart, StmtEnd, Balance) <=> abuts(StartTime, StmtStart) | !log("Hold abuts statement"), reviewed(HoldId);
