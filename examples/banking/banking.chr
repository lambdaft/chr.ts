constraints account/3, transaction/3, loan/3, payment/2;
functions balance/2, eligible/1, overdrawn/1, interest/2;
actions log/1;
import host builtins;

loan(X, C, A) <=> lt(A, 0) | loan(X, C, 0), !log("Loan cleared");
account(X, O, B) <=> lt(B, 0) | account(X, O, 0), !log("Account cleared");
transaction(X, T, D) <=> eq(D, "unknown") | !log("Unknown transaction");
loan(X, C, A) <=> gte(A, 5000) | !log("Large loan");
account(X, O, B) <=> gt(B, 50000) | !log("Premium account");
transaction(X, T, D) <=> !log("Processed");
loan(X, C, A), account(X, C, B) <=> gte(B, A) | !log("Loan fully covered");
transaction(X, T, D), account(X, O, B) ==> eq(D, "deposit") | account(X, O, add(B, 100));
transaction(X, T, D), account(X, O, B) ==> eq(D, "withdraw"), gte(B, 50) | account(X, O, sub(B, 50));
account(X, O, B), loan(X, O, A) ==> gte(B, A) | !log("Loan covered by balance");
loan(X, C, A) ==> eq(A, 0) | !log("Loan fully paid");
transaction(X, T, D) ==> eq(D, "transfer") | !log("Transfer initiated");
account(X, O, B) ==> lt(B, 100) | !log("Low balance");
payment(X, P), account(X, O, B) ==> gt(P, B) | !log("Payment exceeds balance");
loan(X, C, A) ==> eligible(A) | !log("Loan is eligible");
account(X, O, B) \ transaction(X, T, "deposit") <=> eq(T, "deposit") | account(X, O, add(B, 100));
account(X, O, B) \ transaction(X, T, "withdraw") <=> eq(T, "withdraw"), gte(B, 50) | account(X, O, sub(B, 50));
loan(X, C, A) \ payment(X, P) <=> eq(P, "full") | loan(X, C, 0), !log("Loan paid off");
account(X, O, B) \ fee(X, F) <=> gte(B, F) | account(X, O, sub(B, F)), !log("Fee paid");
account(X, O, B) \ account(X, O, B) <=> gte(B, 0) | account(X, O, B), !log("Account validated");