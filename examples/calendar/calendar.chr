constraints event/3, reminder/3, conflict/2, invite/2, attendee/2;
functions overlaps/2, priority/1, duration/2, is_urgent/1;
actions log/1;
import host builtins;

event(X, S, E) <=> gt(E, S) | !log("Valid event");
reminder(X, T, M) <=> lt(T, 0) | !log("Past reminder");
conflict(X, Y) <=> eq(X, Y) | !log("Self conflict");
invite(X, E) <=> eq(E, "cancelled") | !log("Invite cancelled");
attendee(X, E) <=> eq(E, "declined") | !log("Attendee declined");
event(X, S, E) <=> overlaps(S, E) | !log("Overlapping event");
reminder(X, T, M) <=> is_urgent(T) | !log("Urgent reminder");
event(X, S, E), reminder(X, T, M) ==> overlaps(S, E) | !log("Reminder during event");
event(X, S, E), invite(X, I) ==> eq(I, "pending") | !log("Pending invite for event");
attendee(X, E), invite(X, E) ==> eq(E, "pending") | !log("Attendee invited");
conflict(X, Y), event(X, S1, E1), event(Y, S2, E2) ==> overlaps(S1, E1) | !log("Conflict overlap");
event(X, S, E) ==> priority(S) | !log("High priority event");
reminder(X, T, M) ==> lt(T, 60) | !log("Short notice reminder");
attendee(X, E) ==> eq(E, "accepted") | !log("Attendee accepted");
event(X, S, E) \ invite(X, I) <=> eq(I, "needs_action") | event(X, S, E), !log("Event needs action");
reminder(X, T, M) \ event(X, S, E) <=> overlaps(S, E) | !log("Reminder set for event");
conflict(X, Y) \ event(X, S, E) <=> overlaps(S, E) | conflict(X, Y), !log("Conflict registered");
invite(X, E) \ attendee(X, A) <=> eq(A, "accepted") | invite(X, E), !log("Invite updated");
attendee(X, E) \ event(X, S, E) <=> eq(E, "attending") | attendee(X, E), !log("Attendee confirmed");
event(X, S, E) \ event(X, S, E) <=> priority(S) | event(X, S, E), !log("Event prioritzied");