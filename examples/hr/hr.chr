constraints employee/4, review/3, promotion/2, leave/3, training/2;
functions is_senior/1, eligible/1, duration/2, is_mandatory/1, credit/2;
actions log/1;
import host builtins;

employee(X, N, D, R) <=> eq(R, "inactive") | !log("Inactive employee");
review(X, E, S) <=> lt(S, 1) | !log("Poor review");
promotion(X, E) <=> eq(E, "denied") | !log("Promotion denied");
leave(X, E, T) <=> lt(T, 0) | !log("Negative leave");
training(X, C) <=> eq(C, "optional") | !log("Optional training");
employee(X, N, D, R) <=> is_senior(D) | !log("Senior employee");
review(X, E, S) <=> gt(S, 4) | !log("Excellent review");
employee(X, N, D, R), review(X, E, S) ==> gt(S, 3) | promotion(X, "recommended"), !log("Recommended for promotion");
employee(X, N, D, R), leave(X, E, T) ==> gt(T, 30) | !log("Long leave");
training(X, C), employee(X, N, D, R) ==> is_mandatory(C) | !log("Mandatory training required");
promotion(X, E) ==> eligible(E) | !log("Eligible for promotion");
leave(X, E, T) ==> eq(T, "vacation") | !log("Vacation leave");
training(X, C) ==> credit(X, 5) | !log("Training credits earned");
review(X, E, S) ==> eq(S, S) | !log("Review duration");
employee(X, N, D, R) \ review(X, E, S) <=> gt(S, 3) | employee(X, N, D, R), !log("Review completed");
promotion(X, E) \ employee(X, N, D, R) <=> is_senior(D) | promotion(X, E), !log("Promotion approved");
leave(X, E, T) \ employee(X, N, D, R) <=> eq(T, "sick") | leave(X, E, T), !log("Sick leave recorded");
training(X, C) \ employee(X, N, D, R) <=> is_mandatory(C) | training(X, C), !log("Training assigned");
employee(X, N, D, R) \ employee(X, N, D, R) <=> eq(R, "active") | employee(X, N, D, R), !log("Employee active");
review(X, E, S) \ review(X, E, S) <=> gt(S, 0) | review(X, E, S), !log("Review finalized");