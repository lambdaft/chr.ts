constraints user/3, post/3, comment/3, like/2, friend/2;
functions is_viral/1, is_popular/1, length/1, is_recent/1, count/1;
actions log/1;
import host builtins;

user(X, N, A) <=> eq(A, "banned") | !log("Banned user");
post(X, U, T) <=> lt(T, 0) | !log("Invalid timestamp");
comment(X, P, T) <=> eq(T, "spam") | !log("Spam comment");
like(X, P) <=> eq(P, "removed") | !log("Like removed");
friend(X, Y) <=> eq(Y, "blocked") | !log("Blocked friend");
post(X, U, T) <=> is_recent(T) | !log("Recent post");
comment(X, P, T) <=> is_popular(P) | !log("Popular comment");
post(X, U, T), like(X, L) ==> is_viral(L) | post(X, U, "viral"), !log("Viral post");
comment(X, P, T), user(X, U, A) ==> is_recent(T) | !log("Recent comment");
friend(X, Y), user(X, U, A) ==> count(Y) | !log("Friend count noted");
like(X, P) ==> eq(P, "active") | !log("Active like");
user(X, N, A) ==> eq(A, "active") | !log("Active user");
post(X, U, T) ==> length(U) | !log("Post length");
comment(X, P, T) ==> is_popular(P) | !log("Comment popular");
post(X, U, T) \ like(X, L) <=> is_viral(L) | post(X, U, T), !log("Post viral status");
user(X, N, A) \ friend(X, Y) <=> eq(Y, "active") | user(X, N, A), !log("Friend verified");
comment(X, P, T) \ post(X, U, T) <=> is_recent(T) | comment(X, P, T), !log("Comment recent");
like(X, P) \ like(X, P) <=> eq(P, "active") | like(X, P), !log("Like active");
user(X, N, A) \ user(X, N, A) <=> eq(A, "active") | user(X, N, A), !log("User active");
post(X, U, T) \ post(X, U, T) <=> gt(T, 0) | post(X, U, T), !log("Post validated");