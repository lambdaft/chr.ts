constraints device/3, sensor/3, alert/3, actuator/2, reading/3;
functions is_critical/1, is_online/1, temperature/1, humidity/1, motion/1;
actions log/1;
import host builtins;

device(X, T, S) <=> eq(S, "offline") | !log("Device offline");
sensor(X, T, V) <=> lt(V, 0) | !log("Invalid sensor value");
alert(X, T, L) <=> eq(L, "info") | !log("Info alert");
actuator(X, S) <=> eq(S, "idle") | !log("Idle actuator");
reading(X, T, V) <=> lt(V, -50) | !log("Extreme reading");
device(X, T, S) <=> is_online(S) | !log("Online device");
sensor(X, T, V) <=> is_critical(V) | !log("Critical sensor reading");
device(X, T, S), sensor(X, T, V) ==> is_online(S) | !log("Online sensor");
sensor(X, T, V), reading(X, T, V) ==> temperature(V) | !log("Temperature reading");
alert(X, T, L), device(X, T, S) ==> eq(L, "warning") | !log("Device warning");
actuator(X, S), device(X, T, S) ==> eq(S, "active") | !log("Actuator active");
reading(X, T, V) ==> humidity(V) | !log("Humidity reading");
device(X, T, S) ==> motion(S) | !log("Motion detected");
sensor(X, T, V) ==> eq(V, "normal") | !log("Normal sensor");
device(X, T, S) \ sensor(X, T, V) <=> is_online(S) | device(X, T, S), !log("Online sensor device");
sensor(X, T, V) \ reading(X, T, V) <=> temperature(V) | sensor(X, T, V), !log("Temperature sensor reading");
alert(X, T, L) \ actuator(X, S) <=> eq(L, "critical") | alert(X, T, L), !log("Alert triggered");
reading(X, T, V) \ reading(X, T, V) <=> gt(V, 0) | reading(X, T, V), !log("Reading active");
device(X, T, S) \ device(X, T, S) <=> is_online(S) | device(X, T, S), !log("Device status verified");
actuator(X, S) \ actuator(X, S) <=> eq(S, "active") | actuator(X, S), !log("Actuator active");