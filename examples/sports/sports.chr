constraints team/3, player/3, game/4, score/3, injury/2;
functions is_winning/1, is_injured/1, position/1, is_home/1, pts/1;
actions log/1;
import host builtins;

team(X, N, S) <=> eq(S, "inactive") | !log("Inactive team");
player(X, N, P) <=> eq(P, "bench") | !log("Bench player");
game(X, H, A, S) <=> eq(S, "postponed") | !log("Postponed game");
score(X, P, S) <=> lt(S, 0) | !log("Negative score");
injury(X, P) <=> eq(P, "recovered") | !log("Recovered injury");
team(X, N, S) <=> is_home(S) | !log("Home team");
game(X, H, A, S) <=> is_winning(S) | !log("Winning game");
game(X, H, A, S), team(X, H, S1), team(X, A, S2) ==> is_home(S1) | game(X, H, A, "home_win"), !log("Home win");
score(X, P, S), player(X, P, Pos) ==> position(Pos) | !log("Player position noted");
player(X, N, P), injury(X, I) ==> is_injured(I) | player(X, N, "injured"), !log("Player injured");
game(X, H, A, S) ==> pts(S) | !log("Game points tallied");
team(X, N, S) ==> eq(S, "winning") | !log("Team winning");
score(X, P, S) ==> gt(S, 100) | !log("High score");
injury(X, P) ==> is_injured(P) | !log("Injury status");
team(X, N, S) \ player(X, N, P) <=> eq(P, "starter") | team(X, N, S), !log("Starter assigned");
game(X, H, A, S) \ score(X, H, Sh) <=> eq(Sh, "winning") | game(X, H, A, "final"), !log("Game finalized");
player(X, N, P) \ injury(X, I) <=> is_injured(I) | player(X, N, P), !log("Injury checked");
score(X, P, S) \ score(X, P, S) <=> gt(S, 0) | score(X, P, S), !log("Score active");
team(X, N, S) \ team(X, N, S) <=> eq(S, "active") | team(X, N, S), !log("Team active");
game(X, H, A, S) \ game(X, H, A, S) <=> eq(S, "scheduled") | game(X, H, A, "scheduled"), !log("Game scheduled");