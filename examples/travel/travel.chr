constraints booking/4, flight/5, hotel/3, passenger/2, itinerary/2;
functions duration/2, is_available/1, price/2, bookable/1, is_peak/1;
actions log/1;
import host builtins;

booking(X, F, H, S) <=> eq(S, "cancelled") | !log("Booking cancelled");
flight(X, O, D, Dep, Arr) <=> eq(O, D) | !log("Same origin dest");
hotel(X, N, A) <=> lt(A, 1) | !log("No availability");
passenger(X, T) <=> eq(T, "unknown") | !log("Unknown tier");
itinerary(X, I) <=> eq(I, "empty") | !log("Empty itinerary");
flight(X, O, D, Dep, Arr) <=> is_peak(Dep) | !log("Peak flight");
hotel(X, N, A) <=> is_available(A) | !log("Hotel available");
booking(X, F, H, S), flight(X, O, D, Dep, Arr) ==> duration(Dep, Arr) | !log("Flight duration noted");
booking(X, F, H, S), hotel(X, N, A) ==> eq(A, A) | booking(X, F, H, "priced"), !log("Pricing applied");
passenger(X, T), booking(X, F, H, S) ==> is_peak(T) | !log("Peak passenger");
hotel(X, N, A) ==> bookable(A) | !log("Bookable hotel");
flight(X, O, D, Dep, Arr) ==> eq(O, "NYC") | !log("NYC flight");
passenger(X, T) ==> eq(T, "vip") | !log("VIP passenger");
itinerary(X, I) ==> eq(I, "ready") | !log("Itinerary ready");
booking(X, F, H, S) \ flight(X, O, D, Dep, Arr) <=> eq(S, "confirmed") | booking(X, F, H, S), !log("Booking confirmed");
hotel(X, N, A) \ passenger(X, T) <=> is_available(A) | hotel(X, N, A), !log("Hotel verified");
flight(X, O, D, Dep, Arr) \ itinerary(X, I) <=> duration(Dep, Arr) | flight(X, O, D, Dep, Arr), !log("Flight in itinerary");
passenger(X, T) \ passenger(X, T) <=> eq(T, "confirmed") | passenger(X, T), !log("Passenger confirmed");
booking(X, F, H, S) \ booking(X, F, H, S) <=> eq(S, "active") | booking(X, F, H, "active"), !log("Booking active");
itinerary(X, I) \ itinerary(X, I) <=> eq(I, "complete") | itinerary(X, I), !log("Itinerary complete");