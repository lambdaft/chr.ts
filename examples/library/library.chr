constraints book/3, member/3, loan/3, reservation/2, fine/2;
functions is_overdue/1, is_reserved/1, category/1, popularity/1, late_fee/1;
actions log/1;
import host builtins;

book(X, T, A) <=> eq(A, "lost") | !log("Book lost");
member(X, N, S) <=> eq(S, "blocked") | !log("Member blocked");
loan(X, B, D) <=> lt(D, 0) | !log("Invalid loan date");
reservation(X, B) <=> eq(B, "cancelled") | !log("Reservation cancelled");
fine(X, A) <=> lt(A, 0) | !log("Invalid fine");
book(X, T, A) <=> is_reserved(A) | !log("Book reserved");
loan(X, B, D) <=> is_overdue(D) | !log("Overdue loan");
member(X, N, S), loan(X, B, D) ==> eq(S, "active") | loan(X, B, D), !log("Active member loan");
book(X, T, A), loan(X, B, D) ==> category(T) | !log("Book category noted");
loan(X, B, D), fine(X, F) ==> late_fee(F) | fine(X, add(F, 5)), !log("Late fee added");
reservation(X, B) ==> eq(B, "ready") | !log("Reservation ready");
member(X, N, S) ==> eq(S, "active") | !log("Active member");
book(X, T, A) ==> popularity(T) | !log("Popular book");
fine(X, A) ==> eq(A, "paid") | !log("Fine paid");
book(X, T, A) \ loan(X, B, D) <=> is_reserved(A) | book(X, T, A), !log("Reserved book loaned");
member(X, N, S) \ reservation(X, B) <=> eq(S, "active") | member(X, N, S), !log("Member reservation");
loan(X, B, D) \ fine(X, F) <=> is_overdue(D) | fine(X, F), !log("Fine for overdue");
reservation(X, B) \ reservation(X, B) <=> eq(B, "active") | reservation(X, B), !log("Reservation active");
book(X, T, A) \ book(X, T, A) <=> eq(A, "available") | book(X, T, A), !log("Book available");
loan(X, B, D) \ loan(X, B, D) <=> gt(D, 0) | loan(X, B, D), !log("Loan validated");