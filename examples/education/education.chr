constraints student/3, course/3, grade/3, enrollment/2, assignment/3;
functions gpa/2, passed/1, is_fulltime/1, grade_avg/2, due_soon/1;
actions log/1;
import host builtins;

student(X, N, S) <=> eq(S, "inactive") | !log("Inactive student");
course(X, C, Cr) <=> lt(Cr, 1) | !log("Zero credit course");
grade(X, C, G) <=> lt(G, 0) | !log("Invalid grade");
enrollment(X, S) <=> eq(S, "dropped") | !log("Dropped enrollment");
assignment(X, C, D) <=> lt(D, 0) | !log("Past due assignment");
student(X, N, S) <=> is_fulltime(S) | !log("Full-time student");
grade(X, C, G) <=> passed(G) | !log("Passed grade");
enrollment(X, S), course(X, C, Cr) ==> eq(S, "active") | course(X, C, Cr), !log("Active enrollment");
student(X, N, S), grade(X, C, G) ==> gte(G, 3) | !log("Good standing");
course(X, C, Cr), assignment(X, C, D) ==> due_soon(D) | !log("Assignment due soon");
grade(X, C, G) ==> lt(G, 60) | !log("Failing grade");
enrollment(X, S) ==> eq(S, "probation") | !log("Academic probation");
assignment(X, C, D) ==> eq(D, "submitted") | !log("Assignment submitted");
student(X, N, S) ==> eq(S, "graduating") | !log("Graduating student");
enrollment(X, S) \ course(X, C, Cr) <=> eq(S, "active") | enrollment(X, S), !log("Enrollment active");
grade(X, C, G) \ student(X, N, S) <=> gte(G, 3) | grade(X, C, G), !log("Grade verified");
assignment(X, C, D) \ enrollment(X, S) <=> eq(S, "active") | assignment(X, C, D), !log("Assignment for active student");
course(X, C, Cr) \ assignment(X, C, D) <=> due_soon(D) | course(X, C, Cr), !log("Course has due work");
student(X, N, S) \ student(X, N, S) <=> eq(S, "active") | student(X, N, S), !log("Student status set");
grade(X, C, G) \ grade(X, C, G) <=> gte(G, 0) | grade(X, C, G), !log("Grade finalized");