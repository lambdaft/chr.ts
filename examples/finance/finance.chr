constraints marketSession/3, order/4, trade/4, settlement/3, position/4, riskLimit/3, auditLog/3, complianceCheck/3, reportWindow/3, cutoff/2;
functions during/3, before/2, meets/2, overlaps/3, starts/2, ends/2, contains/2, abuts/2, after/2;
actions log/1, alert/1;

import host builtins;

rule_name @ order(OrderId, Symbol, Time, Type) <=> during(Time, 9, 17) | !log("Order accepted"), valid_order(OrderId, Symbol, Time);
rule_name @ order(OrderId, Symbol, Time, Type) <=> !during(Time, 9, 17) | !log("Order rejected: outside market hours"), rejected(OrderId, "outside_hours");

rule_name @ trade(TradeId, Symbol, TradeTime, Price), order(OrderId, Symbol, OrderTime, Type) <=> after(TradeTime, OrderTime) | !log("Trade executed after order"), matched(TradeId, OrderId);
rule_name @ trade(TradeId, Symbol, TradeTime, Price), order(OrderId, Symbol, OrderTime, Type) <=> !after(TradeTime, OrderTime) | !log("Trade rejected: before order"), rejected(TradeId, "before_order");

rule_name @ settlement(SettlementId, TradeId, SettleTime), trade(TradeId, Symbol, TradeTime, Price) <=> after(SettleTime, TradeTime) | !log("Settlement after trade"), settled(SettlementId, TradeId);
rule_name @ settlement(SettlementId, TradeId, SettleTime), trade(TradeId, Symbol, TradeTime, Price) <=> meets(SettleTime, TradeTime) | !log("Settlement at trade time"), settled(SettlementId, TradeId);

rule_name @ position(Portfolio, Symbol, PosTime, Quantity), trade(TradeId, Symbol, TradeTime, Price) <=> starts(PosTime, TradeTime) | !log("Position starts at trade"), updated_position(Portfolio, Symbol, PosTime);
rule_name @ position(Portfolio, Symbol, PosTime, Quantity), trade(TradeId, Symbol, TradeTime, Price) <=> ends(PosTime, TradeTime) | !log("Position ends at trade"), closed_position(Portfolio, Symbol, PosTime);

rule_name @ riskLimit(Portfolio, LimitTime, MaxExposure), position(Portfolio, Symbol, PosTime, Quantity) <=> contains(LimitTime, PosTime) | !log("Risk check during position"), risk_checked(Portfolio, LimitTime);
rule_name @ riskLimit(Portfolio, LimitTime, MaxExposure), position(Portfolio, Symbol, PosTime, Quantity) <=> !contains(LimitTime, PosTime) | !log("Risk check skipped"), risk_skipped(Portfolio, LimitTime);

rule_name @ complianceCheck(CheckId, CheckTime, Rule), order(OrderId, Symbol, OrderTime, Type) <=> meets(CheckTime, OrderTime) | !log("Compliance check at order time"), compliant(CheckId, OrderId);
rule_name @ complianceCheck(CheckId, CheckTime, Rule), order(OrderId, Symbol, OrderTime, Type) <=> starts(CheckTime, OrderTime) | !log("Compliance check starts order"), compliant(CheckId, OrderId);

rule_name @ reportWindow(ReportId, StartTime, EndTime), trade(TradeId, Symbol, TradeTime, Price) <=> during(TradeTime, StartTime, EndTime) | !log("Trade in report window"), reported(ReportId, TradeId);
rule_name @ reportWindow(ReportId, StartTime, EndTime), trade(TradeId, Symbol, TradeTime, Price) <=> overlaps(TradeTime, StartTime, EndTime) | !log("Trade overlaps report window"), partial_report(ReportId, TradeId);

rule_name @ cutoff(CutoffId, CutoffTime), order(OrderId, Symbol, OrderTime, Type) <=> before(OrderTime, CutoffTime) | !log("Order before cutoff"), accepted(OrderId);
rule_name @ cutoff(CutoffId, CutoffTime), order(OrderId, Symbol, OrderTime, Type) <=> !before(OrderTime, CutoffTime) | !log("Order after cutoff"), rejected(OrderId, "after_cutoff");
