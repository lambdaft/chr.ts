constraints portfolio/3, investment/4, risk/2, asset/3, dividend/3;
functions value/2, is_risky/1, returns/2, liquid/1, appreciates/1;
actions log/1;
import host builtins;

portfolio(X, O, V) <=> lt(V, 0) | !log("Negative portfolio");
investment(X, T, A, C) <=> lt(C, 0) | !log("Negative cost");
risk(X, L) <=> gt(L, 10) | !log("High risk");
asset(X, T, V) <=> lt(V, 0) | !log("Negative asset value");
dividend(X, I, A) <=> lt(A, 0) | !log("Negative dividend");
portfolio(X, O, V) <=> gt(V, 1000000) | !log("Millionaire portfolio");
investment(X, T, A, C) <=> is_risky(T) | !log("Risky investment");
portfolio(X, O, V), investment(X, T, A, C) ==> value(A, C) | portfolio(X, O, add(V, C));
asset(X, T, V), investment(X, T, A, C) ==> appreciates(T) | !log("Appreciating asset");
risk(X, L), investment(X, T, A, C) ==> gt(L, 5) | !log("High risk investment");
dividend(X, I, A), investment(X, T, A, C) ==> liquid(T) | dividend(X, I, A), !log("Liquid dividend");
portfolio(X, O, V) ==> gt(V, 500000) | !log("High value portfolio");
investment(X, T, A, C) ==> returns(A, C) | !log("Investment returning");
asset(X, T, V) ==> liquid(T) | !log("Liquid asset");
portfolio(X, O, V) \ investment(X, T, A, C) <=> value(A, C) | portfolio(X, O, add(V, C)), !log("Portfolio updated");
risk(X, L) \ asset(X, T, V) <=> gt(L, 7) | risk(X, L), !log("Asset risk verified");
investment(X, T, A, C) \ dividend(X, I, D) <=> eq(D, "paid") | investment(X, T, A, C), !log("Dividend paid");
asset(X, T, V) \ asset(X, T, V) <=> gt(V, 0) | asset(X, T, V), !log("Asset validated");
portfolio(X, O, V) \ portfolio(X, O, V) <=> gt(V, 0) | portfolio(X, O, V), !log("Portfolio validated");
dividend(X, I, A) \ dividend(X, I, A) <=> gt(A, 0) | dividend(X, I, A), !log("Dividend verified");