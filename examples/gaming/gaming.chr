constraints player/3, match/4, score/3, achievement/2, item/3;
functions level/2, is_win/1, bonus/2, rarity/1, power/1;
actions log/1;
import host builtins;

player(X, N, L) <=> lt(L, 1) | !log("Beginner player");
match(X, P1, P2, R) <=> eq(R, "pending") | !log("Pending match");
score(X, P, Pts) <=> lt(Pts, 0) | !log("Invalid score");
achievement(X, A) <=> eq(A, "locked") | !log("Locked achievement");
item(X, T, R) <=> eq(R, "common") | !log("Common item");
player(X, N, L) <=> gt(L, 50) | !log("High level");
score(X, P, Pts) <=> is_win(Pts) | !log("Winning score");
match(X, P1, P2, R), player(X, P1, L1), player(X, P2, L2) ==> gt(L1, L2) | match(X, P1, P2, "P1_wins"), !log("P1 wins");
score(X, P, Pts), player(X, P, L) ==> gt(Pts, 100) | player(X, P, add(L, 1)), !log("Level up");
achievement(X, A), score(X, P, Pts) ==> gt(Pts, 200) | achievement(X, "unlocked"), !log("Achievement unlocked");
item(X, T, R), score(X, P, Pts) ==> rarity(R) | !log("Rare item found");
match(X, P1, P2, R) ==> eq(R, "draw") | !log("Match drawn");
player(X, N, L) ==> level(N, L) | !log("Player leveled");
item(X, T, R) ==> power(R) | !log("Item powered up");
match(X, P1, P2, R) \ player(X, P1, L) <=> eq(R, "P1_wins") | match(X, P1, P2, "finished"), !log("Match completed");
score(X, P, Pts) \ achievement(X, A) <=> gt(Pts, 150) | score(X, P, Pts), !log("Score verified");
player(X, N, L) \ item(X, T, R) <=> power(R) | player(X, N, L), !log("Item equipped");
match(X, P1, P2, R) \ match(X, P1, P2, R) <=> eq(R, "finished") | match(X, P1, P2, "finished"), !log("Match finalized");
score(X, P, Pts) \ score(X, P, Pts) <=> gt(Pts, 0) | score(X, P, Pts), !log("Score validated");
achievement(X, A) \ achievement(X, A) <=> eq(A, "unlocked") | achievement(X, A), !log("Achievement set");